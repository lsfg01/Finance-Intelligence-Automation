          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "portfolio_version": {
          "minimum": 1,
          "title": "Portfolio Version",
          "type": "integer"
        },
        "profile_version": {
          "minimum": 1,
          "title": "Profile Version",
          "type": "integer"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "abstained"
          ],
          "title": "Status",
          "type": "string"
        },
        "thesis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThesisRef"
            },
            {
              "type": "null"
