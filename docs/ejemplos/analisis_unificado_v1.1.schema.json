          "title": "Events",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "arguments_for": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Arguments For",
          "type": "array"
        },
        "arguments_against": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Arguments Against",
          "type": "array"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "title": "Missing Data",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
