# Ruta local de la base SQLite. Solo para desarrollo y demo.
DB_PATH=.local/portfolio.sqlite3
# Modo simulado por defecto. Habilitar mercado solo para un entorno con licencia aplicable.
ENABLE_LIVE_MARKET_DATA=0
EODHD_API_TOKEN=
# Cliente OAuth de la demo Alpaca Paper. Registra la URL de retorno exacta en Alpaca.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/portfolio/alpaca/callback
